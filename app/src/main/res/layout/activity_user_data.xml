<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/userDataRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <!-- Cím -->
    <TextView
        android:id="@+id/tvUserDataTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Felhasználói adatok"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Felhasználónév label -->
    <TextView
        android:id="@+id/tvUsernameLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Felhasználónév:"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/tvUserDataTitle"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="24dp"/>

    <!-- Felhasználónév érték -->
    <TextView
        android:id="@+id/tvUsernameValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="—"
        android:textSize="16sp"
        app:layout_constraintBaseline_toBaselineOf="@id/tvUsernameLabel"
        app:layout_constraintStart_toEndOf="@id/tvUsernameLabel"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="8dp"/>

    <!-- Email label -->
    <TextView
        android:id="@+id/tvEmailLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Email:"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/tvUsernameLabel"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp"/>

    <!-- Email érték -->
    <TextView
        android:id="@+id/tvEmailValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="—"
        android:textSize="16sp"
        app:layout_constraintBaseline_toBaselineOf="@id/tvEmailLabel"
        app:layout_constraintStart_toEndOf="@id/tvEmailLabel"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="8dp"/>

    <!-- Módosítás gomb -->
    <Button
        android:id="@+id/btnEditUser"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Adatok módosítása"
        app:layout_constraintTop_toBottomOf="@id/tvEmailLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp"/>

    <!-- Törlés gomb -->
    <Button
        android:id="@+id/btnDeleteUser"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Felhasználó törlése"
        app:layout_constraintTop_toBottomOf="@id/btnEditUser"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
